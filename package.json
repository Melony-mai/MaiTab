{
  "name": "maitab",
  "version": "1.5.0",
  "description": "Chrome extension to open links in new tabs without interrupting browsing sessions, with automatic tab switching toggle and domain whitelist overrides.",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "sync": "node scripts/sync-repo.js",
    "sync:check": "node scripts/sync-repo.js --check",
    "sync:server": "node scripts/sync-server.js",
    "iterate": "node scripts/sync-repo.js"
  },
  "keywords": [
    "chrome-extension",
    "tabs",
    "links",
    "manifest-v3"
  ],
  "author": "",
  "license": "MIT"
}
